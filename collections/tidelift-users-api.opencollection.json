{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tidelift External Alignments Users API",
    "version": "1.2.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all users for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tidelift.com/external-api/v1/:org_name/users",
            "params": [
              {
                "name": "org_name",
                "value": "",
                "type": "path",
                "description": "The name of the Organization."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all users for an organization"
        }
      ]
    }
  ],
  "bundled": true
}