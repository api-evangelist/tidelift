{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tidelift External Alignments Catalog Releases API",
    "version": "1.2.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
