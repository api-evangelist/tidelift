{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tidelift External Alignments Vulnerabilities API",
    "version": "1.2.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Vulnerabilities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a vulnerability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tidelift.com/external-api/v1/vulnerabilities/:vulnerability_id",
            "params": [
              {
                "name": "vulnerability_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a vulnerability, along with any recommendation"
        },
        {
          "info": {
            "name": "Get affected releases for a vulnerability",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.tidelift.com/external-api/v1/vulnerabilities/:vulnerability_id/affected_releases",
            "params": [
              {
                "name": "vulnerability_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get affected releases for a vulnerability"
        }
      ]
    }
  ],
  "bundled": true
}